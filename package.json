{
    "name": "localhook",
    "version": "1.0.0",
    "private": true,
    "description": "A local-first HTTP request inspector",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "node scripts/build.mjs --watch",
        "build": "tsc --noEmit && node scripts/build.mjs",
        "start": "node dist/server.js",
        "test": "tsx --test tests/*.test.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "express": "^5.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "esbuild": "^0.28.2",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
